# Mapbox (required for map)
VITE_MAPBOX_ACCESS_TOKEN=

# OpenWeather (optional — mock weather is used when empty or on error)
# Use the "API key" from https://home.openweathermap.org/api_keys (32 hex chars). No quotes.
# After editing .env, restart `npm run dev` so Vite reloads env.
VITE_OPENWEATHER_API_KEY=
# Alias also supported: VITE_OPENWEATHER_KEY=
# Optional override for weather fetch (defaults to BRD corridor centroid)
# VITE_OPENWEATHER_LAT=10.7797
# VITE_OPENWEATHER_LON=106.6949
